{
  "name": "dsh-plugin-media-wallpaper",
  "version": "0.1.6",
  "description": "DeepSeek Harness 壁纸插件：图片/视频背景（GIF/APNG/动图 WebP/PNG/JPEG/MP4/WebM），格式自动识别，压暗/亮度/高斯模糊，界面色调跟随，填充方式可调，侧栏/顶栏等组件透明度可控。纯客户端实现。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laoye666-6/dsh-plugin-media-wallpaper.git"
  },
  "bugs": {
    "url": "https://github.com/laoye666-6/dsh-plugin-media-wallpaper/issues"
  },
  "homepage": "https://github.com/laoye666-6/dsh-plugin-media-wallpaper#readme",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "publish:api": "node scripts/publish-api.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  }
}
